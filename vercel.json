{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "quickbillpos.in" }],
      "destination": "https://www.quickbillpos.in/$1",
      "permanent": true
    },
    { "source": "/privacy_policy", "destination": "/privacy-policy", "permanent": true },
    { "source": "/terms_and_condition", "destination": "/terms-and-conditions", "permanent": true },
    { "source": "/terms_and_conditions", "destination": "/terms-and-conditions", "permanent": true },
    { "source": "/terms_and_condiiton", "destination": "/terms-and-conditions", "permanent": true },
    { "source": "/terms-and-condition", "destination": "/terms-and-conditions", "permanent": true }
  ],
  "rewrites": [{ "source": "/apk-upload", "destination": "/app.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(mockups|icon-192.png|icon-512.png|icon-maskable-512.png|apple-touch-icon.png|og-image.png|favicon.ico|favicon.svg|logo.svg)(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/(sitemap.xml|robots.txt|llms.txt|llms-full.txt)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/apk-upload",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
